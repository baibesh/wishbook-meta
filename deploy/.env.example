# Copy to deploy/.env on the server (never commit it).
POSTGRES_PASSWORD=
WEB_PORT=13110

# Meta Model API
MODELS=meta
MODEL_API_KEY=
STORY_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1
# Model spend at which new books stop, USD.
MODEL_BUDGET_USD=150

# Fill in the book form by voice (Muse Voice Transcribe). Off unless true.
VOICE_INPUT=false

# Books
PAGE_COUNT=10
BOOK_CONCURRENCY=3
FREE_BOOKS=3
DAILY_BOOK_CAP=100
DEMO_DAILY_CAP=50
# Comma-separated codes for judges; pick your own, do not reuse an example.
DEMO_CODES=
ORDER_STAGE_MS=20000

# Admin at /admin. ADMIN_SECRET signs sessions: openssl rand -hex 32
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET=
