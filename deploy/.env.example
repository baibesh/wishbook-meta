# Copy to deploy/.env on the server (never commit it).
POSTGRES_PASSWORD=
WEB_PORT=13110

# Meta Model API
MODELS=meta
MODEL_API_KEY=
STORY_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1
# Model spend at which new books stop, USD.
MODEL_BUDGET_USD=150

# Fill in the book form by voice (Muse Voice Transcribe). Off unless true.
VOICE_INPUT=false

# Books
PAGE_COUNT=10
BOOK_CONCURRENCY=3
FREE_BOOKS=3
DAILY_BOOK_CAP=100
DEMO_DAILY_CAP=50
# Comma-separated codes for judges; pick your own, do not reuse an example.
DEMO_CODES=
ORDER_STAGE_MS=20000

# Sign-in with Keycloak (auth.fabulka.com, deploy/keycloak). AUTH_SECRET signs session cookies:
# openssl rand -hex 32. The client secret is in Keycloak: client fabulka-web → Credentials.
PUBLIC_URL=https://fabulka.com
KEYCLOAK_ISSUER=https://auth.fabulka.com/realms/fabulka
KEYCLOAK_CLIENT_ID=fabulka-web
KEYCLOAK_CLIENT_SECRET=
AUTH_SECRET=

# Order and receipt emails (Resend; the fabulka.com domain verified there).
RESEND_API_KEY=
MAIL_FROM=Fabulka <noreply@fabulka.com>

# Admin at /admin: Keycloak realm role `admin`. ADMIN_SECRET signs admin sessions: openssl rand -hex 32
ADMIN_SECRET=
# Emergency email/password sign-in, off unless true.
ADMIN_PASSWORD_LOGIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
