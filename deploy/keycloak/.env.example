# Fabulka Keycloak — environment for docker-compose.yml and configure.sh.
# The real file lives only on the server: /opt/fabulka-auth/.env (chmod 600, owner root).
# Never commit real values. Generate random ones on the server, e.g. `openssl rand -hex 32`.

# --- used by docker compose ---------------------------------------------------

# Password of the Keycloak Postgres user (database "keycloak", user "keycloak").
KC_DB_PASSWORD=

# Temporary master admin created on the very first start only.
# configure.sh creates the permanent admin below and deletes this one.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Host port Keycloak HTTP is published on (always bound to 127.0.0.1). nginx proxies to it.
KC_HTTP_HOST_PORT=18480

# Private docker network for Keycloak + Postgres. The gateway is the only address
# allowed to send X-Forwarded-* headers (host nginx reaches Keycloak through it).
KC_NETWORK_SUBNET=172.29.50.0/24
KC_PROXY_TRUSTED_ADDRESSES=172.29.50.1

# JVM heap (container limit is 1.5 GB).
KC_JAVA_HEAP="-Xms256m -Xmx768m"

# --- used by configure.sh only (never passed into containers) ----------------

# Permanent master-realm admin (Keycloak admin console at https://auth.fabulka.com/admin/).
KC_ADMIN_USERNAME=fabulka-admin
KC_ADMIN_PASSWORD=

# Secret of the OIDC client "fabulka-web" (the app on fabulka.com uses it).
KEYCLOAK_CLIENT_SECRET=

# Google OAuth client (Google Cloud Console). Authorized redirect URI there:
#   https://auth.fabulka.com/realms/fabulka/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key, used as the SMTP password (host smtp.resend.com:465, SSL, user "resend").
# Leave empty until the fabulka.com domain is verified in Resend.
RESEND_API_KEY=
