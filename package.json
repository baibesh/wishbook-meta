{
  "name": "wishbook",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e:validate": "tapstep validate e2e/flows",
    "e2e": "tapstep test e2e/flows --config e2e/config.yaml"
  }
}
