generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  queued
  toy
  story
  hero
  pages
  pdf
  done
  failed
}

model Book {
  id              String          @id @default(cuid(2))
  status          BookStatus      @default(queued)
  progress        Int             @default(0)
  /// The child profile the parent submitted (ChildProfile in @fabulka/shared).
  child           Json
  language        String
  /// Story method slug (METHODOLOGIES in @fabulka/shared).
  methodology     String          @default("adventure-quest")
  /// What the parent asked the book to be about, if anything.
  theme           String?
  template        BookTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId      String?
  /// Answers to the catalog book's questions, by question key.
  answers         Json?
  title           String?
  heroDescription String?
  /// Muse Image response id of the hero character sheet; pages chain from it.
  heroResponseId  String?
  heroImagePath   String?
  /// The favourite toy: the parent's photo, SAM's cut-out, Spark's description, its character sheet.
  toyName         String?
  toyPhotoPath    String?
  toyCutoutPath   String?
  toyDescription  String?
  toyImagePath    String?
  petImagePath    String?
  /// BookPage[]: { page, text, scenePrompt, imagePath }
  pages           Json            @default("[]")
  /// Questions for the parent to ask after reading (dialogic reading).
  talkQuestions   Json            @default("[]")
  pdfPath         String?
  error           String?
  /// Model spend for this book, in US dollars.
  costUsd         Float           @default(0)
  /// Anonymous visitor key the free limit is counted against.
  clientKey       String
  /// Set when the book was made with a demo code: it does not count against the visitor.
  demo            Boolean         @default(false)
  /// Visitor's country (ISO code) when blocking by country is on; shows demand in the admin.
  country         String?
  /// Picked in the admin to show every visitor on the home page as an example (done books only).
  featured        Boolean         @default(false)
  orders          Order[]
  printInterest   PrintInterest[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clientKey])
  @@index([createdAt, demo])
  @@index([featured, createdAt])
}

/// Books a visitor bought on top of the free ones (demo payment: nothing is charged).
model Credit {
  id        String   @id @default(cuid())
  clientKey String
  books     Int
  priceKzt  Int
  createdAt DateTime @default(now())

  @@index([clientKey])
}

enum Cover {
  soft
  hard
}

/// A printed copy of a book (demo payment; the delivery timeline is simulated).
model Order {
  id            String   @id @default(cuid(2))
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId        String
  recipientName String
  phone         String
  city          String
  address       String
  cover         Cover
  quantity      Int
  booksKzt      Int
  deliveryKzt   Int
  totalKzt      Int
  /// Set by hand in the admin (ORDER_STATUSES); until then the stage follows the demo timer.
  status        String?
  createdAt     DateTime @default(now())

  @@index([bookId])
}

/// Service-wide switches changed in the admin, such as pausing generation.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A catalog book: a plot written by an author that each child's story is adapted from.
model BookTemplate {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  summary      String
  ageMin       Int
  ageMax       Int
  /// Story method slug (METHODOLOGIES in @fabulka/shared).
  methodology  String
  languages    String[]
  /// What the book is about, in English, for Muse Spark.
  theme        String
  /// Plot points in order, in English; Muse Spark spreads them across the pages.
  plot         Json
  /// TemplateQuestion[] (@fabulka/shared).
  questions    Json     @default("[]")
  /// Replaces the default art style in image prompts.
  stylePrompt  String?
  coverUrl     String?
  /// Kazakh and English text by language: TemplateTranslation in @fabulka/shared.
  translations Json     @default("{}")
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  books        Book[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Someone outside Kazakhstan asked for a printed copy: demand for print partners abroad.
model PrintInterest {
  id        String   @id @default(cuid())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  /// Visitor's country (ISO code) when blocking by country is on.
  country   String?
  createdAt DateTime @default(now())

  @@unique([bookId])
}
