PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishbook_meta
# mock: no Meta API calls (tests, CI). meta: real Meta Model API.
MODELS=mock
MOCK_DELAY_MS=300
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
STORY_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
STORAGE_DIR=./storage
PAGE_COUNT=10
# Free books per visitor, then the demo checkout sells more.
FREE_BOOKS=3
# Service-wide caps per UTC day, so a viral link cannot spend the whole model budget.
DAILY_BOOK_CAP=100
DEMO_DAILY_CAP=50
# Comma-separated codes that skip the per-visitor limit (for judges).
DEMO_CODES=
# How long each simulated print/delivery stage takes.
ORDER_STAGE_MS=20000
