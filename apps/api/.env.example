PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishbook_meta
# mock: no Meta API calls (tests, CI). meta: real Meta Model API.
MODELS=mock
MOCK_DELAY_MS=300
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
STORY_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
STORAGE_DIR=./storage
PAGE_COUNT=10
# Free books per visitor, then the demo checkout sells more.
FREE_BOOKS=3
# Service-wide caps per UTC day, so a viral link cannot spend the whole model budget.
DAILY_BOOK_CAP=100
DEMO_DAILY_CAP=50
# Comma-separated codes that skip the per-visitor limit (for judges).
DEMO_CODES=
# How long each simulated print/delivery stage takes.
ORDER_STAGE_MS=20000
# Turn away visitors from countries where Meta's models may not be offered (needs `pnpm geoip`).
GEO_BLOCK=false
GEOIP_DB=./geoip/country.mmdb
# Site address, for the Keycloak callback (PUBLIC_URL/api/auth/callback) and links in emails.
PUBLIC_URL=http://localhost:3000
# Sign-in with Keycloak (optional for visitors). Off when these are empty and AUTH_MOCK is not true.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=fabulka-web
KEYCLOAK_CLIENT_SECRET=
# Signs the session cookies: openssl rand -hex 32 (required in production).
AUTH_SECRET=
# Test-only fake identity provider inside the API (E2E); ignored when NODE_ENV=production.
AUTH_MOCK=false
# Order and receipt emails through Resend; without a key they are only logged.
RESEND_API_KEY=
MAIL_FROM=Fabulka <noreply@fabulka.com>
# Admin at /admin: Keycloak realm role `admin`. ADMIN_SECRET (else AUTH_SECRET) signs admin sessions.
ADMIN_SECRET=
# Emergency email/password sign-in to the admin, off unless true.
ADMIN_PASSWORD_LOGIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true behind HTTPS.
ADMIN_COOKIE_SECURE=false
# Fill in the book form by voice (POST /api/voice, Muse Voice Transcribe). Off unless true.
VOICE_INPUT=false
# Recordings per visitor per hour.
VOICE_HOURLY_LIMIT=20
# Model budget shown on the admin dashboard, USD.
MODEL_BUDGET_USD=150
